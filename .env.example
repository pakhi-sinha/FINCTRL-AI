# Application Mode: test | production
APP_MODE=test

# Database
# For production, use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/database
# For tests, SQLite is automatically used if DATABASE_URL is not set

# API Security
ADMIN_API_KEY=admin_secret_key_here
READ_ONLY_API_KEY=readonly_secret_key_here

# Razorpay Configuration
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI Provider Configuration
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=
