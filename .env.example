# Application Mode: test | production
APP_MODE=test

# Database
# For production, use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/database
# For tests, SQLite is automatically used if DATABASE_URL is not set

# API Security
ADMIN_API_KEY=
READ_ONLY_API_KEY=
CORS_ORIGINS=http://localhost:5173

# Razorpay Configuration
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Durable recovery worker leases (seconds; database time is authoritative)
RECONCILIATION_LEASE_SECONDS=600
RECONCILIATION_HEARTBEAT_SECONDS=120
AI_INVESTIGATION_LEASE_SECONDS=300
AI_INVESTIGATION_HEARTBEAT_SECONDS=60
WEBHOOK_LEASE_SECONDS=120
WEBHOOK_HEARTBEAT_SECONDS=30
RECOVERY_POLL_SECONDS=15
RECOVERY_BATCH_SIZE=25

# AI Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=
